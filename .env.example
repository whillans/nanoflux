PORT=3000
# Optional listen address; defaults to 0.0.0.0 (all interfaces). Use 127.0.0.1 to
# accept connections from this machine only, e.g. behind a same-host reverse proxy.
# HOST=0.0.0.0
# Required. Startup fails if unset or too weak (8+ chars, letters, digits, and symbols)
# MCP is localhost-only by default. Remote access and its bearer token are configured in Settings > MCP.
ADMIN_PASSWORD=
DB_PATH=data.sqlite

# Optional: HTTP(S) proxy for outbound fetches (undici EnvHttpProxyAgent)
# HTTP_PROXY=http://127.0.0.1:9080
# HTTPS_PROXY=http://127.0.0.1:9080
# NO_PROXY=localhost,127.0.0.1

# Optional: feeds, article pages, and covers may not reach loopback, private, or
# link-local addresses. List trusted hosts (exact hostname or IP) to exempt,
# e.g. a self-hosted RSSHub on your LAN.
# FETCH_ALLOW_PRIVATE_HOSTS=localhost,192.168.1.10

# Optional: OpenAI-compatible API via LangChain (when config.json filter.prompt is set)
# LLM_BASE_URL=https://api.openai.com
# LLM_API_KEY=
# LLM_MODEL_NAME=gpt-4o-mini

# WechatRss API
# WECHATRSS_API_KEY=
# WECHATRSS_API_SECRET=

# Telegram Bot API (MCP send_telegram_message, send_telegram_digest)
# Create a bot via @BotFather, then add it as admin of the target channel
# TELEGRAM_BOT_TOKEN=
# Channel username (@mychannel) or numeric id (-100...)
# TELEGRAM_CHANNEL_ID=

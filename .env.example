PORT=3000
# Optional listen address; defaults to 127.0.0.1 (this machine only). To reach
# NanoFlux from other devices, either set the TLS files below and HOST=0.0.0.0,
# or keep HOST at its default behind an HTTPS reverse proxy. HOST=0.0.0.0
# without TLS sends the password, session cookie, and MCP token unencrypted.
# HOST=127.0.0.1
# Optional: serve HTTPS directly, without a reverse proxy. Set both; the
# certificate file must contain the full chain (PEM). Restart after renewing.
# TLS_CERT_FILE=/etc/letsencrypt/live/example.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/example.com/privkey.pem
# Required. Startup fails if unset or too weak (8+ chars, letters, digits, and symbols)
# MCP is localhost-only by default. Remote access and its bearer token are configured in Settings > MCP.
ADMIN_PASSWORD=
DB_PATH=data.sqlite

# Optional: feeds, article pages, and covers may not reach loopback, private, or
# link-local addresses. List trusted hosts (exact hostname or IP) to exempt,
# e.g. a self-hosted RSSHub on your LAN.
# FETCH_ALLOW_PRIVATE_HOSTS=localhost,192.168.1.10

# Optional: OpenAI-compatible API via LangChain (when config.json filter criteria are set)
# LLM_BASE_URL=https://api.openai.com
# LLM_API_KEY=
# LLM_MODEL_NAME=gpt-4o-mini

# WechatRss API
# WECHATRSS_API_KEY=
# WECHATRSS_API_SECRET=
